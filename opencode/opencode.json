{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "description": "Fast codebase exploration",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/explore.md}",
      "mode": "subagent"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "subagent",
      "system": "{file:./prompts/executor.md}"
    },
    "code-reviewer": {
      "description": "Senior code reviewer that evaluates changes across five dimensions \u2014 correctness, readability, architecture, security, and performance. Use for thorough code review before merge.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "color": "#81A1C1"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "color": "#A3BE8C"
    },
    "security-auditor": {
      "description": "Security engineer focused on vulnerability detection, threat modeling, and secure coding practices. Use for security-focused code review, threat analysis, or hardening recommendations.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    },
    "test-engineer": {
      "description": "QA engineer specialized in test strategy, test writing, and coverage analysis. Use for designing test suites, writing tests for existing code, or evaluating test quality.",
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent"
    },
    "web-performance-auditor": {
      "description": "Web performance engineer focused on Core Web Vitals, loading, rendering, and network optimization. Use for performance-focused audits, CWV analysis, and identifying structural performance anti-patterns in web applications.",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent"
    }
  },
  "default_agent": "build",
  "commands": {
    "commit": {
      "description": "Stage and commit changes with auto-generated conventional commit messages",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "{file:./commands/commit.md}"
    },
    "review": {
      "description": "Conduct a five-axis code review \u2014 correctness, readability, architecture, security, performance",
      "model": "opencode/big-pickle",
      "template": "{file:./commands/review.md}"
    },
    "plan": {
      "description": "Break work into small verifiable tasks with acceptance criteria and dependency ordering",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "{file:./commands/plan.md}"
    },
    "build": {
      "description": "Implement tasks incrementally \u2014 build, test, verify, commit. Add \"auto\" to run the whole plan in one approved pass.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "{file:./commands/build.md}"
    },
    "ship": {
      "description": "Run the pre-launch checklist via parallel fan-out to specialist personas, then synthesize a go/no-go decision",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "{file:./commands/ship.md}"
    },
    "test": {
      "description": "Run TDD workflow \u2014 write failing tests, implement, verify. For bugs, use the Prove-It pattern.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "{file:./commands/test.md}"
    },
    "analyst": {
      "description": "Elicit and document project requirements through structured discovery, producing REQUIREMENTS.md",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "{file:./commands/analyst.md}"
    },
    "architect": {
      "description": "Design the solution architecture and produce ARCHITECTURE.md from REQUIREMENTS.md",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "{file:./commands/architect.md}"
    },
    "spec": {
      "description": "Start spec-driven development \u2014 write a structured specification before writing code",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "{file:./commands/spec.md}"
    },
    "simplify": {
      "description": "Simplify code for clarity and maintainability \u2014 reduce complexity without changing behavior",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "{file:./commands/code-simplify.md}"
    }
  },
  "instructions": [
    "./prompts/general.md"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*credentials*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push* -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl*|*sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget*|*sh",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    }
  ]
}

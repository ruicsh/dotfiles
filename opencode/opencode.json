{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "description": "Fast codebase exploration",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/explore.md}",
      "mode": "subagent"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "subagent",
      "system": "{file:./prompts/executor.md}"
    },
    "code-reviewer": {
      "description": "Senior code reviewer that evaluates changes across five dimensions \u2014 correctness, readability, architecture, security, and performance. Use for thorough code review before merge.",
      "model": "opencode-go/deepseek-v4-pro",
      "system": "{file:./prompts/code-reviewer.md}",
      "mode": "subagent"
    },
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "color": "#81A1C1"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "color": "#A3BE8C"
    },
    "security-auditor": {
      "description": "Security engineer focused on vulnerability detection, threat modeling, and secure coding practices. Use for security-focused code review, threat analysis, or hardening recommendations.",
      "model": "opencode-go/deepseek-v4-pro",
      "system": "{file:./prompts/security-auditor.md}",
      "mode": "subagent"
    },
    "test-engineer": {
      "description": "QA engineer specialized in test strategy, test writing, and coverage analysis. Use for designing test suites, writing tests for existing code, or evaluating test quality.",
      "model": "opencode-go/deepseek-v4-pro",
      "system": "{file:./prompts/test-engineer.md}",
      "mode": "subagent"
    },
    "web-performance-auditor": {
      "description": "Web performance engineer focused on Core Web Vitals, loading, rendering, and network optimization. Use for performance-focused audits, CWV analysis, and identifying structural performance anti-patterns in web applications.",
      "model": "opencode-go/deepseek-v4-pro",
      "system": "{file:./prompts/web-performance-auditor.md}",
      "mode": "subagent"
    }
  },
  "default_agent": "build",
  "commands": {
    "commit": {
      "description": "Stage and commit changes with auto-generated conventional commit messages",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "@commit"
    },
    "build": {
      "description": "Implement tasks incrementally \u2014 build, test, verify, commit. Add \"auto\" to run the whole plan in one approved pass.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "template": "Load the `build` skill. `$ARGUMENTS` picks the mode: `auto` (or `all`) runs the whole plan after one approval, anything else implements the next task and stops."
    },
    "plan": {
      "description": "Turn a spec into tasks/plan.md \u2014 ordered tasks with acceptance criteria, sized for the build skill",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "@plan"
    },
    "ship": {
      "description": "Run the pre-launch checklist via parallel fan-out to specialist subagents, then synthesize a go/no-go decision",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "Load the `ship` skill. `$ARGUMENTS` is the scope; if empty, use the staged changes or the most recent commits."
    },
    "review": {
      "description": "Review current changes across correctness, readability, architecture, security, performance",
      "model": "opencode-go/deepseek-v4-pro",
      "template": "@review"
    }
  },
  "instructions": [
    "~/.config/opencode/prompts/general.md",
    "~/.agents/skills/skill-router/SKILL.md",
    "~/.agents/skills/terse-voice/SKILL.md"
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*credentials*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push* -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl*|*sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget*|*sh",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    }
  ]
}

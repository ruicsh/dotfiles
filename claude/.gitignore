*
!.gitignore
!CLAUDE.md
!settings.json
!commands/
!commands/**
!themes/
!themes/**
# Installed skills are CLI-created symlinks into ~/.agents/skills and stay ignored.
# build, commit, plan and review are tracked so a fresh checkout has /build, /commit, /plan and /review.
!skills/
!skills/build
!skills/commit
!skills/plan
!skills/review
